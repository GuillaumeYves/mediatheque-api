# Copier en .env puis adapter. Aucune valeur réelle ici.
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/mediatheque

# Port hôte de PostgreSQL lancé par docker compose.
DB_PORT=5432

# Secret de signature des access tokens, 32 caractères au moins.
# Générer : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=remplacer-par-un-secret-aleatoire-de-48-octets

# Durées de vie : access token (900 s au plus), refresh token (jours).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Coût bcrypt, 12 au minimum.
BCRYPT_COST=12

# Origines autorisées par CORS, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# Limitation de débit : tentatives sur /api/auth par quart d'heure, requêtes par minute.
AUTH_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_MAX=300

# Nombre de proxys de confiance devant l'API (0 en local).
TRUST_PROXY=0

# Durée d'un emprunt créé automatiquement pour une réservation, en jours.
DUREE_EMPRUNT_JOURS=14

# Assistant : bouchon (sans clé, sans réseau) ou openai.
IA_FOURNISSEUR=bouchon
# Requis uniquement avec IA_FOURNISSEUR=openai. Ne jamais versionner de clé réelle.
OPENAI_API_KEY=
OPENAI_MODELE=gpt-4.1-mini
# Plafond de jetons générés par réponse.
IA_MAX_JETONS_SORTIE=400
# Questions par minute et par compte.
ASSISTANT_RATE_LIMIT_MAX=10
# Délai entre deux mots diffusés par le bouchon, en millisecondes.
IA_BOUCHON_DELAI_MS=40
# Jetons d'entrée et de sortie autorisés par compte et par jour (minuit UTC).
IA_QUOTA_JETONS_JOUR=20000

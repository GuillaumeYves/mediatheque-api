{
  "name": "mediatheque-api",
  "version": "2.0.0",
  "description": "REST API for a community media library: catalogue, loans, reservations and an AI assistant, built with Express 5, TypeScript, Zod and Prisma.",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "check": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "test": "node --env-file-if-exists=.env.test --test --test-global-setup=test/global-setup.ts --test-concurrency=1 \"test/**/*.test.ts\"",
    "postinstall": "prisma generate"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "openai": "^7.57.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "bcrypt": false,
    "@scarf/scarf": false
  }
}

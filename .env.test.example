# Environnement des tests : copier en .env.test. Base distincte de la base de développement.
DATABASE_URL=postgresql://app:app@localhost:5432/mediatheque_test

# Secret factice réservé aux tests.
JWT_ACCESS_SECRET=secret-de-test-uniquement-ne-pas-utiliser-ailleurs-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:5173

# Plafond large : chaque test qui vérifie le 429 crée sa propre application.
AUTH_RATE_LIMIT_MAX=1000
GLOBAL_RATE_LIMIT_MAX=10000

# Les tests n'appellent jamais de fournisseur réel.
IA_FOURNISSEUR=bouchon
